{
  "name": "Telegram Disappearing Photos",
  "version": "1.0",
  "description": "Send disappearing photos on Telegram Web",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://web.telegram.org/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["patched-worker.js", "inject.js"],
      "matches": ["*://web.telegram.org/*"]
    }
  ],
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://web.telegram.org/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "telegram_worker_patch",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
