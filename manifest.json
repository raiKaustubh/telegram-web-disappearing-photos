{
  "name": "Telegram Disappearing Photos",
  "version": "1.0",
  "description": "Send disappearing photos on Telegram Web",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://web.telegram.org/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://web.telegram.org/*"]
    }
  ],
  "permissions": [],
  "host_permissions": ["*://web.telegram.org/*"]
}
